<?xml version="1.0" encoding="UTF-8" ?>
<ChoregrapheProject xmlns="http://www.aldebaran-robotics.com/schema/choregraphe/project.xsd" xar_version="3">
    <Box name="root" id="-1" tooltip="Coreografia NAO sincronizzata con Daft Punk - One More Time" x="0" y="0">
        <bitmap>media/images/box/root.png</bitmap>
        <script language="4">
            <content>
                <![CDATA[
import math
import threading
import time

try:
    from naoqi import ALProxy
except ImportError:
    pass

class MyClass(GeneratedClass):
    def __init__(self):
        GeneratedClass.__init__(self)

    def onLoad(self):
        pass

    def onUnload(self):
        pass

    def onInput_onStop(self):
        if hasattr(self, "_choreography_stop"):
            self._choreography_stop.set()
        if hasattr(self, "_deadline_cancel"):
            self._deadline_cancel.set()
        if hasattr(self, "_motion_proxy"):
            try:
                self._motion_proxy.stopMove()
            except Exception as error:
                print("Impossibile interrompere lo spostamento: %s" % error)
            try:
                self._motion_proxy.killAll()
            except Exception as error:
                print("Impossibile interrompere i movimenti: %s" % error)
        self.onUnload()
        if not getattr(self, "_stop_sent", False):
            self._stop_sent = True
            self.onStopped()

    def onInput_onStart(self):
        # NOTA: La musica va avviata ESTERNAMENTE (da main.py o manualmente).
        # NON usare subprocess/os dentro Choregraphe: crasha il simulatore.

        choreography_target_time = 120.0
        crouch_start_time = 114.0
        choreography_stop = threading.Event()
        deadline_expired = threading.Event()
        deadline_cancel = threading.Event()
        motion_proxy_holder = []
        self._stop_sent = False
        self._choreography_stop = choreography_stop
        self._deadline_cancel = deadline_cancel

        def stop_robot_motion():
            if not motion_proxy_holder:
                return
            motion_proxy = motion_proxy_holder[0]
            try:
                motion_proxy.stopMove()
            except Exception as error:
                print("Impossibile interrompere lo spostamento: %s" % error)
            try:
                motion_proxy.killAll()
            except Exception as error:
                print("Impossibile interrompere i movimenti: %s" % error)

        def notify_stopped():
            if not self._stop_sent:
                self._stop_sent = True
                self.onStopped()

        def enforce_deadline():
            while not deadline_cancel.is_set():
                remaining = choreography_start + choreography_target_time - time.time()
                if remaining <= 0:
                    break
                time.sleep(min(0.01, remaining))
            if deadline_cancel.is_set():
                return
            deadline_expired.set()
            choreography_stop.set()
            print("[LIMITE] 120 secondi raggiunti: arresto movimenti e coreografia.")
            stop_robot_motion()
            notify_stopped()

        proxy_result = {}
        proxy_error = []
        proxy_ready = threading.Event()

        def connect_proxies():
            try:
                try:
                    motion_proxy = ALProxy("ALMotion")
                    posture_proxy = ALProxy("ALRobotPosture")
                except Exception:
                    motion_proxy = ALProxy("ALMotion", "127.0.0.1", 9559)
                    posture_proxy = ALProxy("ALRobotPosture", "127.0.0.1", 9559)
                proxy_result["motion"] = motion_proxy
                proxy_result["posture"] = posture_proxy
            except Exception as error:
                proxy_error.append(error)
            finally:
                proxy_ready.set()

        proxy_thread = threading.Thread(target=connect_proxies)
        proxy_thread.daemon = True
        proxy_thread.start()
        proxy_ready.wait(15.0)
        if not proxy_ready.is_set():
            print("Connessione ai proxy NAOqi scaduta dopo 15 secondi.")
            deadline_cancel.set()
            choreography_stop.set()
            notify_stopped()
            return
        if proxy_error:
            print("Impossibile connettersi ai proxy NAOqi: %s" % proxy_error[0])
            deadline_cancel.set()
            choreography_stop.set()
            notify_stopped()
            return
        motionProxy = proxy_result["motion"]
        postureProxy = proxy_result["posture"]
        self._motion_proxy = motionProxy
        motion_proxy_holder.append(motionProxy)
        choreography_start = time.time()
        deadline_thread = threading.Thread(target=enforce_deadline)
        deadline_thread.daemon = True
        deadline_thread.start()

        DANCE_JOINTS = ['LShoulderPitch', 'LShoulderRoll', 'LElbowYaw', 'LElbowRoll', 'LWristYaw', 'LHand', 'RShoulderPitch', 'RShoulderRoll', 'RElbowYaw', 'RElbowRoll', 'RWristYaw', 'RHand', 'HeadYaw', 'HeadPitch']
        DANCE_PHRASES = {'disco_groove': [(28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (42, 12, -75, -78, 0, 0.0, 42, -12, 75, 78, 0, 0.0, 0.0, 0.0), (28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0), (52, 8, -80, -35, 0, 0.2, 52, -8, 80, 35, 0, 0.2, 0.0, 0.0), (42, 12, -75, -78, 0, 0.0, 42, -12, 75, 78, 0, 0.0, 0.0, 0.0), (28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0)], 'side_step_groove': [(38, 38, -65, -45, 0, 0.1, 42, -20, 72, 65, 0, 0.2, -16, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0), (42, 20, -72, -65, 0, 0.2, 38, -38, 65, 45, 0, 0.1, 16, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0), (38, 38, -65, -45, 0, 0.1, 42, -20, 72, 65, 0, 0.2, -16, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0), (42, 20, -72, -65, 0, 0.2, 38, -38, 65, 45, 0, 0.1, 16, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0)], 'robot_pulse': [(52, 8, -80, -35, 0, 0.2, 52, -8, 80, 35, 0, 0.2, 0.0, 0.0), (42, 12, -75, -78, 0, 0.0, 42, -12, 75, 78, 0, 0.0, 0.0, 0.0), (52, 8, -80, -35, 0, 0.2, 52, -8, 80, 35, 0, 0.2, 0.0, 0.0), (28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (52, 8, -80, -35, 0, 0.2, 52, -8, 80, 35, 0, 0.2, 0.0, 0.0), (42, 12, -75, -78, 0, 0.0, 42, -12, 75, 78, 0, 0.0, 0.0, 0.0), (52, 8, -80, -35, 0, 0.2, 52, -8, 80, 35, 0, 0.2, 0.0, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0)], 'arm_wave_combo': [(18, 30, -65, -65, 0, 0.1, -38, -18, 70, 28, 0, 0.1, -12, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0), (28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (38, 38, -65, -45, 0, 0.1, 42, -20, 72, 65, 0, 0.2, -16, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0), (18, 30, -65, -65, 0, 0.1, -38, -18, 70, 28, 0, 0.1, -12, 0.0), (28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0)], 'party_punches': [(28, 12, -70, -82, 0, 0.0, 58, -35, 60, 42, 0, 0.0, -10, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0), (58, 35, -60, -42, 0, 0.0, 28, -12, 70, 82, 0, 0.0, 10, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0), (28, 12, -70, -82, 0, 0.0, 58, -35, 60, 42, 0, 0.0, -10, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0), (58, 35, -60, -42, 0, 0.0, 28, -12, 70, 82, 0, 0.0, 10, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0)], 'climax_reach': [(18, 30, -65, -65, 0, 0.1, -38, -18, 70, 28, 0, 0.1, -12, 0.0), (28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (28, 12, -70, -82, 0, 0.0, 58, -35, 60, 42, 0, 0.0, -10, 0.0), (28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (18, 30, -65, -65, 0, 0.1, -38, -18, 70, 28, 0, 0.1, -12, 0.0), (58, 35, -60, -42, 0, 0.0, 28, -12, 70, 82, 0, 0.0, 10, 0.0), (28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0)], 'hello_wave': [(78, 16, -68, -49, 0, 0.0, 28, -20, 70, 65, 20, 1.0, 0.0, 0.0), (78, 16, -68, -49, 0, 0.0, 28, -20, 70, 45, -20, 1.0, -8, 0.0), (78, 16, -68, -49, 0, 0.0, 28, -20, 70, 80, 40, 1.0, 8, 0.0), (78, 16, -68, -49, 0, 0.0, 28, -20, 70, 45, -20, 1.0, -8, 0.0), (78, 16, -68, -49, 0, 0.0, 28, -20, 70, 80, 40, 1.0, 8, 0.0), (78, 16, -68, -49, 0, 0.0, 28, -20, 70, 45, -20, 1.0, -8, 0.0), (78, 16, -68, -49, 0, 0.0, 28, -20, 70, 80, 40, 1.0, 8, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0)], 'wipe_forehead': [(78, 16, -68, -49, 0, 0.0, 20, -25, 45, 80, -40, 0.0, -10, 0.0), (78, 16, -68, -49, 0, 0.0, 28, -20, 55, 88, 20, 0.0, 10, 0.0), (78, 16, -68, -49, 0, 0.0, 20, -25, 45, 80, -40, 0.0, -10, 0.0), (78, 16, -68, -49, 0, 0.0, 28, -20, 55, 88, 20, 0.0, 10, 0.0), (78, 16, -68, -49, 0, 0.0, 20, -25, 45, 80, -40, 0.0, -10, 0.0), (78, 16, -68, -49, 0, 0.0, 28, -20, 55, 88, 20, 0.0, 10, 0.0), (78, 16, -68, -49, 0, 0.0, 28, -20, 70, 65, 20, 1.0, 0.0, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0)], 'arm_to_sky': [(68, 16, -68, -49, 0, 0.0, -48, -32, 80, 30, 0, 0.0, 8, 0.0), (78, 16, -68, -49, 0, 0.0, -60, -40, 80, 20, 0, 0.0, 0.0, 0.0), (28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (68, 16, -68, -49, 0, 0.0, -48, -32, 80, 30, 0, 0.0, 8, 0.0), (78, 16, -68, -49, 0, 0.0, -60, -40, 80, 20, 0, 0.0, 0.0, 0.0), (28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (68, 16, -68, -49, 0, 0.0, -48, -32, 80, 30, 0, 0.0, 8, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0)], 'right_arm': [(68, 16, -68, -49, 0, 0.0, -48, -32, 80, 30, 0, 0.0, 8, 0.0), (78, 16, -68, -49, 0, 0.0, -60, -40, 80, 20, 0, 0.0, 0.0, 0.0), (28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (78, 16, -68, -49, 0, 0.0, -60, -40, 80, 20, 0, 0.0, 0.0, 0.0), (68, 16, -68, -49, 0, 0.0, -48, -32, 80, 30, 0, 0.0, 8, 0.0), (28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (78, 16, -68, -49, 0, 0.0, -60, -40, 80, 20, 0, 0.0, 0.0, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0)], 'union_arms': [(28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (42, 12, -76, -48, 0, 0.2, 42, -12, 76, 48, 0, 0.2, 0.0, 0.0), (52, 8, -80, -35, 0, 0.2, 52, -8, 80, 35, 0, 0.2, 0.0, 0.0), (42, 12, -76, -48, 0, 0.2, 42, -12, 76, 48, 0, 0.2, 0.0, 0.0), (28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (42, 12, -76, -48, 0, 0.2, 42, -12, 76, 48, 0, 0.2, 0.0, 0.0), (52, 8, -80, -35, 0, 0.2, 52, -8, 80, 35, 0, 0.2, 0.0, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0)], 'seated_arm_to_sky': [(78, 16, -68, -49, 0, 0.0, -48, -28, 80, 30, 0, 0.0, 0.0, -5), (64, 18, -68, -45, 0, 0.0, -38, -28, 80, 35, 0, 0.0, 10, -3), (78, 16, -68, -49, 0, 0.0, -48, -28, 80, 30, 0, 0.0, 0.0, -5), (64, 18, -68, -45, 0, 0.0, -38, -28, 80, 35, 0, 0.0, 10, -3), (78, 16, -68, -49, 0, 0.0, -48, -28, 80, 30, 0, 0.0, 0.0, -5), (64, 18, -68, -45, 0, 0.0, -38, -28, 80, 35, 0, 0.0, 10, -3), (78, 16, -68, -49, 0, 0.0, -48, -28, 80, 30, 0, 0.0, 0.0, -5), (64, 18, -68, -45, 0, 0.0, -38, -28, 80, 35, 0, 0.0, 10, -3)]}

        def wait_until(target_time, filler_name=None):
            filler_index = 0
            while not choreography_stop.is_set():
                remaining = target_time - time.time()
                if remaining <= 0:
                    return True
                if filler_name and remaining > 0.08:
                    pose = DANCE_PHRASES[filler_name][
                        filler_index % len(DANCE_PHRASES[filler_name])
                    ]
                    frame_duration = min(0.5, remaining)
                    angle_lists = []
                    time_lists = []
                    for joint_index, joint_name in enumerate(DANCE_JOINTS):
                        angle = pose[joint_index]
                        if joint_name not in ("LHand", "RHand"):
                            angle = math.radians(angle)
                        angle_lists.append([angle])
                        time_lists.append([frame_duration])
                    try:
                        motionProxy.angleInterpolation(
                            DANCE_JOINTS, angle_lists, time_lists, True
                        )
                    except Exception as error:
                        print(
                            "Impossibile eseguire il movimento di raccordo: %s"
                            % error
                        )
                        filler_name = None
                    filler_index += 1
                else:
                    time.sleep(min(0.05, remaining))
            return False

        def wait_for_task(task_proxy, task_id, deadline, stop_task):
            while task_proxy.isRunning(task_id):
                if choreography_stop.is_set() or time.time() >= deadline:
                    stop_task()
                    return False
                time.sleep(0.03)
            return not choreography_stop.is_set() and time.time() <= deadline

        def run_posture_action(name, speed, deadline):
            if choreography_stop.is_set() or time.time() >= deadline:
                print("Deadline raggiunta prima della transizione a %s." % name)
                return False
            try:
                task_id = postureProxy.post.goToPosture(name, speed)
                completed = wait_for_task(
                    postureProxy, task_id, deadline, stop_robot_motion
                )
                if not completed:
                    print("Transizione a %s interrotta alla deadline." % name)
                return completed
            except Exception as error:
                print("Errore nella transizione a %s: %s" % (name, error))
                return False

        def play_dance_phrase(name, duration, deadline):
            if choreography_stop.is_set() or time.time() >= deadline:
                print("Deadline raggiunta prima della frase %s." % name)
                return False
            try:
                poses = DANCE_PHRASES[name]
                frame_times = [
                    duration * frame / float(len(poses))
                    for frame in range(1, len(poses) + 1)
                ]
                angle_lists = []
                time_lists = []
                for joint_index, joint_name in enumerate(DANCE_JOINTS):
                    joint_angles = [pose[joint_index] for pose in poses]
                    if joint_name not in ("LHand", "RHand"):
                        joint_angles = [math.radians(angle) for angle in joint_angles]
                    angle_lists.append(joint_angles)
                    time_lists.append(frame_times)
                task_id = motionProxy.post.angleInterpolation(
                    DANCE_JOINTS, angle_lists, time_lists, True
                )
                completed = wait_for_task(
                    motionProxy, task_id, deadline,
                    lambda: motionProxy.stop(task_id)
                )
                if not completed:
                    print("Frase %s interrotta alla deadline." % name)
                return completed
            except Exception as error:
                print("Errore nella frase %s: %s" % (name, error))
                return False

        def run_move_action(name, displacement, deadline):
            if choreography_stop.is_set() or time.time() >= deadline:
                print("Deadline raggiunta prima dello spostamento %s." % name)
                return False
            try:
                task_id = motionProxy.post.moveTo(*displacement)
                completed = wait_for_task(
                    motionProxy, task_id, deadline,
                    lambda: motionProxy.stop(task_id)
                )
                if not completed:
                    print("Spostamento %s interrotto alla deadline." % name)
                return completed
            except Exception as error:
                print("Errore nello spostamento %s: %s" % (name, error))
                return False

        last_action_completed = True

        # ======================================================================
        # PASSO 01 [Inizio]: StandInit (0.0s -> 4.0s)
        # Evento Musicale: NAO in attesa del primo beat.
        # ======================================================================
        if choreography_stop.is_set(): return
        if not wait_until(choreography_start + 0.00): return
        last_action_completed = run_posture_action("StandInit", 1.0, choreography_start + 4.00)
        if not last_action_completed: print("StandInit non completato.")
        # ======================================================================
        # PASSO 02 [Intro: The Horns Hook]: disco_groove (4.0s -> 8.7s)
        # Evento Musicale: Riff sintetico di fiati. NAO si attiva nel groove e saluta il pubblico.
        # ======================================================================
        if choreography_stop.is_set(): return
        if not wait_until(choreography_start + 4.00, "disco_groove" if last_action_completed else None): return
        last_action_completed = play_dance_phrase("disco_groove", 4.663, choreography_start + 8.66)
        if not last_action_completed: print("Azione disco_groove non completata.")
        # ======================================================================
        # PASSO 03 [Intro: The Horns Hook]: right_arm (8.7s -> 14.7s)
        # Evento Musicale: Riff sintetico di fiati. NAO si attiva nel groove e saluta il pubblico.
        # ======================================================================
        if choreography_stop.is_set(): return
        if not wait_until(choreography_start + 8.66, "disco_groove" if last_action_completed else None): return
        last_action_completed = play_dance_phrase("right_arm", 6.000, choreography_start + 14.66)
        if not last_action_completed: print("Azione right_arm non completata.")
        # ======================================================================
        # PASSO 04 [Intro: The Horns Hook]: Hello (14.7s -> 19.2s)
        # Evento Musicale: Riff sintetico di fiati. NAO si attiva nel groove e saluta il pubblico.
        # ======================================================================
        if choreography_stop.is_set(): return
        if not wait_until(choreography_start + 14.66, "disco_groove" if last_action_completed else None): return
        last_action_completed = play_dance_phrase("hello_wave", 4.500, choreography_start + 19.16)
        if not last_action_completed: print("Azione Hello non completata.")
        # ======================================================================
        # PASSO 05 [Verse 1: 'One more time, we're gonna celebrate...']: arm_to_sky (19.2s -> 23.3s)
        # Evento Musicale: Entra la voce robotica e il basso funky. Danza a tutto corpo e posa scenica.
        # ======================================================================
        if choreography_stop.is_set(): return
        if not wait_until(choreography_start + 19.16, "disco_groove" if last_action_completed else None): return
        last_action_completed = play_dance_phrase("arm_to_sky", 4.163, choreography_start + 23.33)
        if not last_action_completed: print("Azione arm_to_sky non completata.")
        # ======================================================================
        # PASSO 06 [Verse 1: 'One more time, we're gonna celebrate...']: right_arm (23.3s -> 29.3s)
        # Evento Musicale: Entra la voce robotica e il basso funky. Danza a tutto corpo e posa scenica.
        # ======================================================================
        if choreography_stop.is_set(): return
        if not wait_until(choreography_start + 23.33, "disco_groove" if last_action_completed else None): return
        last_action_completed = play_dance_phrase("right_arm", 6.000, choreography_start + 29.33)
        if not last_action_completed: print("Azione right_arm non completata.")
        # ======================================================================
        # PASSO 07 [Verse 1: 'One more time, we're gonna celebrate...']: arm_wave_combo (29.3s -> 33.4s)
        # Evento Musicale: Entra la voce robotica e il basso funky. Danza a tutto corpo e posa scenica.
        # ======================================================================
        if choreography_stop.is_set(): return
        if not wait_until(choreography_start + 29.33, "disco_groove" if last_action_completed else None): return
        last_action_completed = play_dance_phrase("arm_wave_combo", 4.065, choreography_start + 33.39)
        if not last_action_completed: print("Azione arm_wave_combo non completata.")
        # ======================================================================
        # PASSO 08 [Verse 1: 'One more time, we're gonna celebrate...']: StandZero (33.4s -> 37.4s)
        # Evento Musicale: Entra la voce robotica e il basso funky. Danza a tutto corpo e posa scenica.
        # ======================================================================
        if choreography_stop.is_set(): return
        if not wait_until(choreography_start + 33.39, "disco_groove" if last_action_completed else None): return
        last_action_completed = run_posture_action("StandZero", 1.0, choreography_start + 37.39)
