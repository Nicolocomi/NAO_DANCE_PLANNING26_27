<?xml version="1.0" encoding="UTF-8" ?>
<ChoregrapheProject xmlns="http://www.aldebaran-robotics.com/schema/choregraphe/project.xsd" xar_version="3">
    <Box name="root" id="-1" tooltip="Coreografia NAO sincronizzata con Daft Punk - One More Time" x="0" y="0">
        <bitmap>media/images/box/root.png</bitmap>
        <script language="4">
            <content>
                <![CDATA[
import math
import threading
import time

try:
    from naoqi import ALProxy
except ImportError:
    pass

class MyClass(GeneratedClass):
    def __init__(self):
        GeneratedClass.__init__(self)

    def onLoad(self):
        pass

    def onUnload(self):
        pass

    def onInput_onStop(self):
        if hasattr(self, "_choreography_stop"):
            self._choreography_stop.set()
        if hasattr(self, "_deadline_cancel"):
            self._deadline_cancel.set()
        if hasattr(self, "_motion_proxy"):
            try:
                self._motion_proxy.stopMove()
            except Exception as error:
                print("Impossibile interrompere lo spostamento: %s" % error)
            try:
                self._motion_proxy.killAll()
            except Exception as error:
                print("Impossibile interrompere i movimenti: %s" % error)
        self.onUnload()
        self.onStopped()

    def onInput_onStart(self):
        # NOTA: La musica va avviata ESTERNAMENTE (da main.py o manualmente).
        # NON usare subprocess/os dentro Choregraphe: crasha il simulatore.

        choreography_start = time.time()
        choreography_target_time = 120.0
        crouch_start_time = 116.0
        choreography_stop = threading.Event()
        deadline_expired = threading.Event()
        deadline_cancel = threading.Event()
        motion_proxy_holder = []
        self._choreography_stop = choreography_stop
        self._deadline_cancel = deadline_cancel

        def stop_robot_motion():
            if not motion_proxy_holder:
                return
            motion_proxy = motion_proxy_holder[0]
            try:
                motion_proxy.stopMove()
            except Exception as error:
                print("Impossibile interrompere lo spostamento: %s" % error)
            try:
                motion_proxy.killAll()
            except Exception as error:
                print("Impossibile interrompere i movimenti: %s" % error)

        def enforce_deadline():
            while not deadline_cancel.is_set():
                remaining = choreography_start + choreography_target_time - time.time()
                if remaining <= 0:
                    break
                time.sleep(min(0.01, remaining))
            if deadline_cancel.is_set():
                return
            deadline_expired.set()
            choreography_stop.set()
            print("[LIMITE] 120 secondi raggiunti: arresto movimenti e coreografia.")
            stop_robot_motion()
            self.onStopped()

        deadline_thread = threading.Thread(target=enforce_deadline)
        deadline_thread.daemon = True
        deadline_thread.start()

        proxy_result = {}
        proxy_error = []
        proxy_ready = threading.Event()

        def connect_proxies():
            try:
                try:
                    motion_proxy = ALProxy("ALMotion")
                    posture_proxy = ALProxy("ALRobotPosture")
                except Exception:
                    motion_proxy = ALProxy("ALMotion", "127.0.0.1", 9559)
                    posture_proxy = ALProxy("ALRobotPosture", "127.0.0.1", 9559)
                proxy_result["motion"] = motion_proxy
                proxy_result["posture"] = posture_proxy
            except Exception as error:
                proxy_error.append(error)
            finally:
                proxy_ready.set()

        proxy_thread = threading.Thread(target=connect_proxies)
        proxy_thread.daemon = True
        proxy_thread.start()
        while not proxy_ready.is_set() and not choreography_stop.is_set():
            remaining = choreography_start + choreography_target_time - time.time()
            if remaining <= 0:
                break
            time.sleep(min(0.01, remaining))
        if not proxy_ready.is_set() or choreography_stop.is_set():
            return
        if proxy_error:
            print("Impossibile connettersi ai proxy NAOqi: %s" % proxy_error[0])
            deadline_cancel.set()
            choreography_stop.set()
            self.onStopped()
            return
        motionProxy = proxy_result["motion"]
        postureProxy = proxy_result["posture"]
        self._motion_proxy = motionProxy
        motion_proxy_holder.append(motionProxy)
        if deadline_expired.is_set():
            stop_robot_motion()
            return

        def arm_angles(pitch, roll, eyaw, eroll, wyaw=0.0, hand=0.0):
            return [
                math.radians(pitch),
                math.radians(roll),
                math.radians(eyaw),
                math.radians(eroll),
                math.radians(wyaw),
                hand
            ]

        DANCE_JOINTS = ['LShoulderPitch', 'LShoulderRoll', 'LElbowYaw', 'LElbowRoll', 'LWristYaw', 'LHand', 'RShoulderPitch', 'RShoulderRoll', 'RElbowYaw', 'RElbowRoll', 'RWristYaw', 'RHand', 'HeadYaw', 'HeadPitch']
        DANCE_PHRASES = {'disco_groove': [(28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (42, 12, -75, -78, 0, 0.0, 42, -12, 75, 78, 0, 0.0, 0.0, 0.0), (28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0), (52, 8, -80, -35, 0, 0.2, 52, -8, 80, 35, 0, 0.2, 0.0, 0.0), (42, 12, -75, -78, 0, 0.0, 42, -12, 75, 78, 0, 0.0, 0.0, 0.0), (28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0)], 'side_step_groove': [(38, 38, -65, -45, 0, 0.1, 42, -20, 72, 65, 0, 0.2, -16, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0), (42, 20, -72, -65, 0, 0.2, 38, -38, 65, 45, 0, 0.1, 16, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0), (38, 38, -65, -45, 0, 0.1, 42, -20, 72, 65, 0, 0.2, -16, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0), (42, 20, -72, -65, 0, 0.2, 38, -38, 65, 45, 0, 0.1, 16, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0)], 'robot_pulse': [(52, 8, -80, -35, 0, 0.2, 52, -8, 80, 35, 0, 0.2, 0.0, 0.0), (42, 12, -75, -78, 0, 0.0, 42, -12, 75, 78, 0, 0.0, 0.0, 0.0), (52, 8, -80, -35, 0, 0.2, 52, -8, 80, 35, 0, 0.2, 0.0, 0.0), (28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (52, 8, -80, -35, 0, 0.2, 52, -8, 80, 35, 0, 0.2, 0.0, 0.0), (42, 12, -75, -78, 0, 0.0, 42, -12, 75, 78, 0, 0.0, 0.0, 0.0), (52, 8, -80, -35, 0, 0.2, 52, -8, 80, 35, 0, 0.2, 0.0, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0)], 'arm_wave_combo': [(18, 30, -65, -65, 0, 0.1, -38, -18, 70, 28, 0, 0.1, -12, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0), (28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (38, 38, -65, -45, 0, 0.1, 42, -20, 72, 65, 0, 0.2, -16, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0), (18, 30, -65, -65, 0, 0.1, -38, -18, 70, 28, 0, 0.1, -12, 0.0), (28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0)], 'party_punches': [(28, 12, -70, -82, 0, 0.0, 58, -35, 60, 42, 0, 0.0, -10, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0), (58, 35, -60, -42, 0, 0.0, 28, -12, 70, 82, 0, 0.0, 10, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0), (28, 12, -70, -82, 0, 0.0, 58, -35, 60, 42, 0, 0.0, -10, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0), (58, 35, -60, -42, 0, 0.0, 28, -12, 70, 82, 0, 0.0, 10, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0)], 'climax_reach': [(18, 30, -65, -65, 0, 0.1, -38, -18, 70, 28, 0, 0.1, -12, 0.0), (28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (28, 12, -70, -82, 0, 0.0, 58, -35, 60, 42, 0, 0.0, -10, 0.0), (28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (18, 30, -65, -65, 0, 0.1, -38, -18, 70, 28, 0, 0.1, -12, 0.0), (58, 35, -60, -42, 0, 0.0, 28, -12, 70, 82, 0, 0.0, 10, 0.0), (28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0)], 'hello_wave': [(78, 16, -68, -49, 0, 0.0, 28, -20, 70, 65, 20, 1.0, 0.0, 0.0), (78, 16, -68, -49, 0, 0.0, 28, -20, 70, 45, -20, 1.0, -8, 0.0), (78, 16, -68, -49, 0, 0.0, 28, -20, 70, 80, 40, 1.0, 8, 0.0), (78, 16, -68, -49, 0, 0.0, 28, -20, 70, 45, -20, 1.0, -8, 0.0), (78, 16, -68, -49, 0, 0.0, 28, -20, 70, 80, 40, 1.0, 8, 0.0), (78, 16, -68, -49, 0, 0.0, 28, -20, 70, 45, -20, 1.0, -8, 0.0), (78, 16, -68, -49, 0, 0.0, 28, -20, 70, 80, 40, 1.0, 8, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0)], 'wipe_forehead': [(78, 16, -68, -49, 0, 0.0, 20, -25, 45, 80, -40, 0.0, -10, 0.0), (78, 16, -68, -49, 0, 0.0, 28, -20, 55, 88, 20, 0.0, 10, 0.0), (78, 16, -68, -49, 0, 0.0, 20, -25, 45, 80, -40, 0.0, -10, 0.0), (78, 16, -68, -49, 0, 0.0, 28, -20, 55, 88, 20, 0.0, 10, 0.0), (78, 16, -68, -49, 0, 0.0, 20, -25, 45, 80, -40, 0.0, -10, 0.0), (78, 16, -68, -49, 0, 0.0, 28, -20, 55, 88, 20, 0.0, 10, 0.0), (78, 16, -68, -49, 0, 0.0, 28, -20, 70, 65, 20, 1.0, 0.0, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0)], 'arm_to_sky': [(78, 16, -68, -49, 0, 0.0, -60, -40, 80, 20, 0, 0.0, 0.0, 0.0), (78, 16, -68, -49, 0, 0.0, -60, -40, 80, 20, 0, 0.0, 0.0, 0.0), (28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (78, 16, -68, -49, 0, 0.0, -60, -40, 80, 20, 0, 0.0, 0.0, 0.0), (28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (28, 38, -60, -28, 0, 0.2, 28, -38, 60, 28, 0, 0.2, 0.0, 0.0), (78, 16, -68, -49, 0, 0.0, 78, -16, 68, 49, 0, 0.0, 0.0, 0.0)], 'seated_arm_to_sky': [(78, 16, -68, -49, 0, 0.0, -48, -28, 80, 30, 0, 0.0, 0.0, -5), (64, 18, -68, -45, 0, 0.0, -38, -28, 80, 35, 0, 0.0, 10, -3), (78, 16, -68, -49, 0, 0.0, -48, -28, 80, 30, 0, 0.0, 0.0, -5), (64, 18, -68, -45, 0, 0.0, -38, -28, 80, 35, 0, 0.0, 10, -3), (78, 16, -68, -49, 0, 0.0, -48, -28, 80, 30, 0, 0.0, 0.0, -5), (64, 18, -68, -45, 0, 0.0, -38, -28, 80, 35, 0, 0.0, 10, -3), (78, 16, -68, -49, 0, 0.0, -48, -28, 80, 30, 0, 0.0, 0.0, -5), (78, 16, -68, -49, 0, 0.0, -48, -28, 80, 30, 0, 0.0, 0.0, -5)]}

        def wait_until(target_time):
            while not choreography_stop.is_set():
                remaining = target_time - time.time()
                if remaining <= 0:
                    return True
                time.sleep(min(0.05, remaining))
            return False

        def wait_for_task(task_proxy, task_id, deadline, stop_task):
            while task_proxy.isRunning(task_id):
                if choreography_stop.is_set() or time.time() >= deadline:
                    stop_task()
                    return False
                time.sleep(0.03)
            return not choreography_stop.is_set() and time.time() <= deadline

        def run_posture_action(name, speed, deadline):
            if choreography_stop.is_set() or time.time() >= deadline:
                print("Deadline raggiunta prima della transizione a %s." % name)
                return False
            try:
                task_id = postureProxy.post.goToPosture(name, speed)
                completed = wait_for_task(
                    postureProxy, task_id, deadline, stop_robot_motion
                )
                if not completed:
                    print("Transizione a %s interrotta alla deadline." % name)
                return completed
            except Exception as error:
                print("Errore nella transizione a %s: %s" % (name, error))
                return False

        def play_dance_phrase(name, duration, deadline):
            if choreography_stop.is_set() or time.time() >= deadline:
                print("Deadline raggiunta prima della frase %s." % name)
                return False
            try:
                poses = DANCE_PHRASES[name]
                frame_times = [
                    duration * frame / float(len(poses))
                    for frame in range(1, len(poses) + 1)
                ]
                angle_lists = []
                time_lists = []
                for joint_index, joint_name in enumerate(DANCE_JOINTS):
                    joint_angles = [pose[joint_index] for pose in poses]
                    if joint_name not in ("LHand", "RHand"):
                        joint_angles = [math.radians(angle) for angle in joint_angles]
                    angle_lists.append(joint_angles)
                    time_lists.append(frame_times)
                task_id = motionProxy.post.angleInterpolation(
                    DANCE_JOINTS, angle_lists, time_lists, True
                )
                completed = wait_for_task(
                    motionProxy, task_id, deadline,
                    lambda: motionProxy.stop(task_id)
                )
                if not completed:
                    print("Frase %s interrotta alla deadline." % name)
                return completed
            except Exception as error:
                print("Errore nella frase %s: %s" % (name, error))
                return False

        # ======================================================================
        # PASSO 01 [Inizio]: StandInit (0.0s -> 4.0s)
        # Evento Musicale: NAO in attesa del primo beat.
        # ======================================================================
        if choreography_stop.is_set(): return
        if not wait_until(choreography_start + 0.00): return
        if choreography_stop.is_set(): return
        run_posture_action("StandInit", 0.65, choreography_start + 4.00)
        if choreography_stop.is_set(): return
        # ======================================================================
        # PASSO 02 [Intro: The Horns Hook]: disco_groove (4.0s -> 7.9s)
        # Evento Musicale: Riff sintetico di fiati. NAO si attiva nel groove e saluta il pubblico.
        # ======================================================================
        if choreography_stop.is_set(): return
        if not wait_until(choreography_start + 4.00): return
        if choreography_stop.is_set(): return
        play_dance_phrase("disco_groove", 3.937, choreography_start + 7.94)
        if choreography_stop.is_set(): return
        # ======================================================================
        # PASSO 03 [Intro: The Horns Hook]: right_arm (7.9s -> 13.9s)
        # Evento Musicale: Riff sintetico di fiati. NAO si attiva nel groove e saluta il pubblico.
        # ======================================================================
        if choreography_stop.is_set(): return
        if not wait_until(choreography_start + 7.94): return
        r_up = arm_angles(-60.0, -40.0, 80.0, 20.0, 0.0, 0.9)
        r_circle = arm_angles(-40.0, -60.0, 60.0, 50.0, 40.0, 0.9)
        if choreography_stop.is_set(): return
        motionProxy.angleInterpolation("RArm", r_up, 3.000, True)
        if choreography_stop.is_set(): return
        if choreography_stop.is_set(): return
        motionProxy.angleInterpolation("RArm", r_circle, 3.000, True)
        if choreography_stop.is_set(): return
        # ======================================================================
        # PASSO 04 [Intro: The Horns Hook]: Hello (13.9s -> 18.4s)
        # Evento Musicale: Riff sintetico di fiati. NAO si attiva nel groove e saluta il pubblico.
        # ======================================================================
        if choreography_stop.is_set(): return
        if not wait_until(choreography_start + 13.94): return
        if choreography_stop.is_set(): return
        play_dance_phrase("hello_wave", 4.500, choreography_start + 18.44)
        if choreography_stop.is_set(): return
        # ======================================================================
        # PASSO 05 [Verse 1: 'One more time, we're gonna celebrate...']: arm_to_sky (18.4s -> 21.4s)
        # Evento Musicale: Entra la voce robotica e il basso funky. Danza a tutto corpo e posa scenica.
        # ======================================================================
        if choreography_stop.is_set(): return
        if not wait_until(choreography_start + 18.44): return
        if choreography_stop.is_set(): return
        play_dance_phrase("arm_to_sky", 3.000, choreography_start + 21.44)
        if choreography_stop.is_set(): return
        # ======================================================================
        # PASSO 06 [Verse 1: 'One more time, we're gonna celebrate...']: right_arm (21.4s -> 27.4s)
        # Evento Musicale: Entra la voce robotica e il basso funky. Danza a tutto corpo e posa scenica.
        # ======================================================================
        if choreography_stop.is_set(): return
        if not wait_until(choreography_start + 21.44): return
        r_up = arm_angles(-60.0, -40.0, 80.0, 20.0, 0.0, 0.9)
        r_circle = arm_angles(-40.0, -60.0, 60.0, 50.0, 40.0, 0.9)
        if choreography_stop.is_set(): return
        motionProxy.angleInterpolation("RArm", r_up, 3.000, True)
        if choreography_stop.is_set(): return
        if choreography_stop.is_set(): return
        motionProxy.angleInterpolation("RArm", r_circle, 3.000, True)
        if choreography_stop.is_set(): return
        # ======================================================================
        # PASSO 07 [Verse 1: 'One more time, we're gonna celebrate...']: diagonal_left (27.4s -> 31.4s)
        # Evento Musicale: Entra la voce robotica e il basso funky. Danza a tutto corpo e posa scenica.
        # ======================================================================
        if choreography_stop.is_set(): return
        if not wait_until(choreography_start + 27.44): return
        try:
            task_id = motionProxy.post.moveTo(0.10, 0.08, 0.0)
            if not wait_for_task(motionProxy, task_id, choreography_start + 31.44, stop_robot_motion):
                print("diagonal_left interrotto alla deadline del passo.")
        except Exception as error:
            print("Errore diagonal_left: %s" % error)
        # ======================================================================
        # PASSO 08 [Verse 1: 'One more time, we're gonna celebrate...']: StandZero (31.4s -> 34.9s)
        # Evento Musicale: Entra la voce robotica e il basso funky. Danza a tutto corpo e posa scenica.
        # ======================================================================
        if choreography_stop.is_set(): return
        if not wait_until(choreography_start + 31.44): return
        if choreography_stop.is_set(): return
        run_posture_action("StandZero", 0.65, choreography_start + 34.94)
        if choreography_stop.is_set(): return
        # ======================================================================
        # PASSO 09 [Chorus 1: First Party Drop]: diagonal_right (34.9s -> 38.9s)
        # Evento Musicale: Drop del ritornello: assolo di chitarra rock sul campionamento prima del break.
        # ======================================================================
        if choreography_stop.is_set(): return
        if not wait_until(choreography_start + 34.94): return
        try:
            task_id = motionProxy.post.moveTo(0.10, -0.08, 0.0)
            if not wait_for_task(motionProxy, task_id, choreography_start + 38.94, stop_robot_motion):
                print("diagonal_right interrotto alla deadline del passo.")
        except Exception as error:
            print("Errore diagonal_right: %s" % error)
        # ======================================================================
        # PASSO 10 [Chorus 1: First Party Drop]: move_backward (38.9s -> 42.9s)
        # Evento Musicale: Drop del ritornello: assolo di chitarra rock sul campionamento prima del break.
        # ======================================================================
        if choreography_stop.is_set(): return
        if not wait_until(choreography_start + 38.94): return
        try:
            task_id = motionProxy.post.moveTo(-0.12, 0.0, 0.0)
            if not wait_for_task(motionProxy, task_id, choreography_start + 42.94, stop_robot_motion):
                print("move_backward interrotto alla deadline del passo.")
        except Exception as error:
            print("Errore move_backward: %s" % error)
        # ======================================================================
        # PASSO 11 [Chorus 1: First Party Drop]: union_arms (42.9s -> 46.9s)
        # Evento Musicale: Drop del ritornello: assolo di chitarra rock sul campionamento prima del break.
        # ======================================================================
        if choreography_stop.is_set(): return
        if not wait_until(choreography_start + 42.94): return
        if choreography_stop.is_set(): return
        motionProxy.post.angleInterpolation("LArm", arm_angles(10, 10, -80, -80, 0, 0.5), 4.000, True)
        if choreography_stop.is_set(): return
        if choreography_stop.is_set(): return
        motionProxy.angleInterpolation("RArm", arm_angles(10, -10, 80, 80, 0, 0.5), 4.000, True)
        if choreography_stop.is_set(): return
        # ======================================================================
        # PASSO 12 [Chorus 1: First Party Drop]: climax_reach (46.9s -> 50.9s)
        # Evento Musicale: Drop del ritornello: assolo di chitarra rock sul campionamento prima del break.
        # ======================================================================
        if choreography_stop.is_set(): return
        if not wait_until(choreography_start + 46.94): return
        if choreography_stop.is_set(): return
        play_dance_phrase("climax_reach", 3.937, choreography_start + 50.88)
        if choreography_stop.is_set(): return
        # ======================================================================
        # PASSO 13 [Chorus 1: First Party Drop]: Sit (50.9s -> 55.9s)
